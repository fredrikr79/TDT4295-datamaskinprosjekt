{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Host: game (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/../build/host/hexmcu_host",
            "args": [],
            "cwd": "${workspaceFolder}/..",
            "environment": [
                {
                    "name": "HEXMCU_SD",
                    "value": "${workspaceFolder}/sd"
                },
                {
                    "name": "ASAN_OPTIONS",
                    "value": "detect_leaks=0"
                }
            ],
            "MIMode": "gdb",
            "preLaunchTask": "build host",
            "setupCommands": [
                {
                    "description": "Pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Host: game, 2 % errors (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/../build/host/hexmcu_host",
            "args": [
                "--errors=2"
            ],
            "cwd": "${workspaceFolder}/..",
            "environment": [
                {
                    "name": "HEXMCU_SD",
                    "value": "${workspaceFolder}/sd"
                },
                {
                    "name": "ASAN_OPTIONS",
                    "value": "detect_leaks=0"
                }
            ],
            "MIMode": "gdb",
            "preLaunchTask": "build host",
            "setupCommands": [
                {
                    "description": "Pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}