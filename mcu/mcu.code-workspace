{
    // The whole MCU side in one window. Open with File > Open Workspace from
    // File... (or double-click this file). This file lives in mcu/.
    //
    // No folder here may contain more than one CMake project, or the
    // STM32Cube extension refuses it ("contains multiple CMake projects").
    // So mcu/ and hexMCU/ themselves are not folders here; their parts are.
    //
    // Build / run / debug:
    //   hexU59, hexU54: the STM32 extension, as when the folder is opened alone
    //   host:           Run and Debug > "Host: ..." builds it first (tasks.json)
    "folders": [
        { "name": "src (shared code)",          "path": "hexMCU/src" },
        { "name": "cmake (shared build files)", "path": "hexMCU/cmake" },
        { "name": "docs",                       "path": "docs" },
        { "name": "tools",                      "path": "tools" },
        { "name": "hexU59 (final board, U595)", "path": "hexMCU/cube/hexU59" },
        { "name": "hexU54 (Nucleo-U545RE-Q)",   "path": "hexMCU/cube/hexU54" },
        { "name": "host (PC emulator)",         "path": "hexMCU/host" }
    ],
    "settings": {
        // The build button builds the "active folder". Don't let it follow the
        // file being edited (src/ has no CMakeLists.txt, so it asked for a
        // kit): keep hexU59 active, switch with the folder name in the
        // status bar or "CMake: Select Active Folder".
        "cmake.autoSelectActiveFolder": false,
        "cmake.defaultActiveFolder": "hexU59 (final board, U595)",
        "cmake.ignoreCMakeListsMissing": true,
        "stm32cube-ide-clangd.path": "cube",
        "stm32cube-ide-clangd.arguments": [
            "starm-clangd",
            "--query-driver=${env:CUBE_BUNDLE_PATH}/gnu-tools-for-stm32/14.3.1+st.2/bin/arm-none-eabi-gcc*",
            "--query-driver=${env:CUBE_BUNDLE_PATH}/gnu-tools-for-stm32/14.3.1+st.2/bin/arm-none-eabi-g++*"
        ]
    }
}
